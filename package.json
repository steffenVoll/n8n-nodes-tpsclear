{
	"name": "n8n-nodes-tpsclear",
	"version": "0.1.0",
	"description": "n8n community node for TPSClear: screen UK phone numbers against the TPS and CTPS registers, manage your suppression and consent lists, and read API usage",
	"license": "MIT",
	"homepage": "https://tpsclear.co.uk",
	"keywords": [
		"n8n-community-node-package",
		"tpsclear",
		"tps",
		"ctps",
		"telephone-preference-service",
		"phone-screening",
		"compliance"
	],
	"author": {
		"name": "Voll Studios Ltd",
		"email": "hello@tpsclear.co.uk"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/steffenVoll/n8n-nodes-tpsclear.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TpsClearApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TpsClear/TpsClear.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "4.1.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
